"use client";
import { useState } from "react";
import { motion } from "framer-motion";
import { copy } from "@/app/(content)/copy";

declare global {
  interface Window {
    fbq?: (...args: any[]) => void;
    gtag?: (...args: any[]) => void;
  }
}

export default function LeadForm() {
  const [status, setStatus] = useState<"idle" | "sending" | "sent" | "error">("idle");
  const [errMsg, setErrMsg] = useState<string>("");

  async function onSubmit(e: React.FormEvent<HTMLFormElement>) {
    e.preventDefault();
    setStatus("sending");
    setErrMsg("");
    const form = e.currentTarget;
    const data = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch("/api/lead", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      setStatus("sent");
      form.reset();
      window.fbq?.("track", "Lead");
      window.gtag?.("event", "generate_lead", { source: "{{slug}}" });
    } catch (err: any) {
      setStatus("error");
      setErrMsg(err?.message || "שגיאה. נסו שוב.");
    }
  }

  return (
    <section id="lead" className="px-6 py-20 max-w-2xl mx-auto">
      <motion.div
        initial={{ opacity: 0, y: 12 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true, margin: "-80px" }}
        transition={{ duration: 0.5 }}
        className="rounded-2xl border border-text/10 bg-surface p-8"
      >
        <h2 className="text-2xl md:text-3xl font-bold mb-2">{copy.leadForm.heading}</h2>
        <p className="text-text/80 mb-6">{copy.leadForm.subheading}</p>

        <form onSubmit={onSubmit} className="space-y-4" aria-busy={status === "sending"}>
          <label className="block">
            <span className="text-sm font-medium">שם מלא</span>
            <input
              required
              name="name"
              autoComplete="name"
              className="mt-1 w-full rounded-lg border border-text/15 bg-bg px-4 py-3 text-text placeholder:text-mute focus:border-accent outline-none transition-colors"
              placeholder="ישראל ישראלי"
            />
          </label>
          <label className="block">
            <span className="text-sm font-medium">טלפון</span>
            <input
              required
              name="phone"
              type="tel"
              inputMode="tel"
              autoComplete="tel"
              dir="ltr"
              className="mt-1 w-full rounded-lg border border-text/15 bg-bg px-4 py-3 text-text placeholder:text-mute focus:border-accent outline-none transition-colors"
              placeholder="054-1234567"
            />
          </label>
          <label className="block">
            <span className="text-sm font-medium">הודעה (אופציונלי)</span>
            <textarea
              name="message"
              rows={3}
              className="mt-1 w-full rounded-lg border border-text/15 bg-bg px-4 py-3 text-text placeholder:text-mute focus:border-accent outline-none transition-colors resize-none"
              placeholder="מתי נוח שנחזור?"
            />
          </label>
          <button
            type="submit"
            disabled={status === "sending"}
            className="w-full rounded-full bg-accent text-black font-bold py-3 shadow-glow disabled:opacity-60 hover:scale-[1.01] active:scale-[0.99] transition-transform"
          >
            {status === "sending" ? "שולח..." : status === "sent" ? "נשלח ✓" : copy.leadForm.submitLabel}
          </button>
          {status === "error" && (
            <p role="alert" className="text-red-400 text-sm" aria-live="polite">
              {errMsg}
            </p>
          )}
          {status === "sent" && (
            <p role="status" className="text-accent text-sm" aria-live="polite">
              {copy.leadForm.successMessage}
            </p>
          )}
        </form>

        <p className="text-xs text-mute mt-6">{copy.leadForm.disclaimer}</p>
      </motion.div>
    </section>
  );
}
