"use client";
import { useState } from "react";

type Check = { id: string; label: string; status: "pass" | "warn" | "fail"; fix: string };

export default function SeoCheckPage() {
  const [url, setUrl] = useState("{{siteUrl}}/");
  const [result, setResult] = useState<any>(null);
  const [loading, setLoading] = useState(false);
  const [err, setErr] = useState("");

  async function run(e: React.FormEvent) {
    e.preventDefault();
    setLoading(true);
    setErr("");
    setResult(null);
    try {
      const r = await fetch("/api/seo-check", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ url }),
      });
      const json = await r.json();
      if (!json.ok) throw new Error(json.error || "failed");
      setResult(json);
    } catch (e: any) {
      setErr(e?.message || "שגיאה");
    } finally {
      setLoading(false);
    }
  }

  return (
    <main className="max-w-3xl mx-auto px-6 py-16">
      <h1 className="text-4xl font-extrabold mb-2">בדיקת SEO חינם</h1>
      <p className="text-text/80 mb-8">11 בדיקות בסיסיות — title, meta, schema, alt text ועוד. ללא הרשמה.</p>

      <form onSubmit={run} className="flex gap-2 mb-8">
        <input
          value={url}
          onChange={(e) => setUrl(e.target.value)}
          dir="ltr"
          type="url"
          required
          className="flex-1 rounded-lg border border-text/15 bg-surface px-4 py-3 outline-none focus:border-accent"
          placeholder="https://example.com"
        />
        <button
          type="submit"
          disabled={loading}
          className="rounded-full bg-accent text-black font-bold px-6 py-3 shadow-glow disabled:opacity-60"
        >
          {loading ? "בודק..." : "בדוק"}
        </button>
      </form>

      {err && <p className="text-red-400 mb-6">{err}</p>}

      {result && (
        <div>
          <div className="rounded-2xl border border-text/10 bg-surface p-6 mb-6 flex items-center gap-6">
            <div className="text-6xl font-extrabold text-accent">{result.score}</div>
            <div>
              <div className="font-bold text-lg">ציון כללי</div>
              <div className="text-mute text-sm">מתוך 100 · {result.checks.length} בדיקות</div>
            </div>
          </div>

          <div className="space-y-3">
            {result.checks.map((c: Check) => (
              <div key={c.id} className="rounded-xl border border-text/10 bg-surface p-4 flex gap-4 items-start">
                <div className={`w-3 h-3 rounded-full mt-2 ${c.status === "pass" ? "bg-green-500" : c.status === "warn" ? "bg-amber-400" : "bg-red-500"}`} />
                <div className="flex-1">
                  <div className="font-bold">{c.label}</div>
                  {c.status !== "pass" && <div className="text-sm text-text/80 mt-1">{c.fix}</div>}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </main>
  );
}
